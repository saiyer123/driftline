# Copy to .env at the repo root and fill in your own Alpaca PAPER keys.
# Get them free at https://app.alpaca.markets (Paper Trading section).
# Never commit .env. The engine refuses to start if ALPACA_PAPER is not true.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Cognition plane (Claude researcher/reviewer/strategist). Create a key at
# https://console.anthropic.com — or skip this and run `ant auth login` instead.
ANTHROPIC_API_KEY=
